    "xinitrc": "#!/bin/bash\nmkdir -p /SETTINGS/{DOWNLOAD,UPDATE}\nmkdir -p /SETTINGS/ucs/{0,1}\nfallocate -l 65536 /SETTINGS/hdd\n\nGLX=\"$(readlink /etc/alternatives/glx)\"\nRES=\"$(cat /root/.resolution)\"\n\nexport __GL_SYNC_TO_VBLANK=1\nexport force_s3tc_enable=true\nexport vblank_mode=2\n\n\nif [[ \"$(echo \"$GLX\" | grep 'mesa')\" ]];\nthen\n\tif [[ \"$RES\" == \"SD\" ]];\n\tthen\n\t\txrandr --current -s 640x480\n\telse\n\t\txrandr --current -s 1280x720\n\tfi\n\tCURRENT_RES=\"$(xrandr | grep '*')\"\n\tRES_60=\"$(echo \"$CURRENT_RES\" | grep -E '60\\...\\*')\"\n\tRES_59=\"$(echo \"$CURRENT_RES\" | grep -E '59\\...\\*')\"\n\tRES_AVAIL=\"$(echo \"$CURRENT_RES\" | grep -Eo '(60\\...|59\\...)' | head -n1)\"\n\tif [[ \"$CURRENT_RES\" ]] && [[ \"$RES_60\" == \"\" && \"$RES_59\" == \"\" ]];\n\tthen\n\t\txrandr -r 60.00 || xrandr -r 59.94 || xrandr -r \"$RES_AVAIL\"\n\tfi\nelse\n\tif [[ \"$RES\" == \"HD\" ]];\n\tthen\n\t\txrandr --current -s 1920x1080\n\telif [[ \"$RES\" == \"SD\" ]];\n\tthen\n\t\txrandr --current -s 640x480\n\tfi\nfi\n\ncd /root/game\nLD_PRELOAD=\"./libflh.so ./squeak_senselock_emu.so\" ./exec /mnt/hd/game/\n#xterm\n"
